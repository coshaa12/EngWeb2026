extends layout

block content
    .w3-card-4
        header.w3-container.w3-teal
            h1 Lista de Atores
            a.w3-btn.w3-right.w3-margin-top.w3-blue(href="/") Voltar
        
        .w3-container
            table.w3-table-all.w3-hoverable
                tr
                    th Ator
                    th # Filmes
                each a in list
                    tr(onclick=`window.location='/atores/${encodeURIComponent(a.nome)}'` style="cursor:pointer")
                        td= a.nome
                        td= a.numFilmes
                        
        footer.w3-container.w3-teal
            h5 Gerado por EngWeb2026 em #{d}