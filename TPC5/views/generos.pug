extends layout

block content
    .w3-card-4
        header.w3-container.w3-teal
            h1 Lista de Géneros
            a.w3-btn.w3-right.w3-margin-top.w3-blue(href="/") Voltar
        
        .w3-container
            table.w3-table-all.w3-hoverable
                tr
                    th Género
                    th # Filmes
                each g in list
                    tr(onclick=`window.location='/generos/${encodeURIComponent(g.nome)}'` style="cursor:pointer")
                        td= g.nome
                        td= g.numFilmes
                        
        footer.w3-container.w3-teal
            h5 Gerado por EngWeb2026 em #{d}