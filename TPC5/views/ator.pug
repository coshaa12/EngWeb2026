extends layout

block content
    .w3-card-4
        header.w3-container.w3-teal
            h1 Página do Ator: #{ator}
        
        .w3-container
            h3 Filmes em que participou:
            ul.w3-ul.w3-hoverable
                each f in list
                    li
                        a(href=`/filmes/${f.id}`)= f.title + " (" + f.year + ")"
                        
        footer.w3-container.w3-teal.w3-margin-top
            address
                a(href="/atores") Voltar à lista de atores
            h5 Gerado por EngWeb2026 em #{d}