extends layout

block content
    .w3-card-4
        header.w3-container.w3-teal
            h1.w3-left Lista de Filmes
            a.w3-btn.w3-right.w3-margin-top.w3-blue(href="/atores") Ver Atores
            a.w3-btn.w3-right.w3-margin-top.w3-margin-right.w3-blue(href="/generos") Ver Géneros
        
        .w3-container
            table.w3-table-all.w3-hoverable
                tr
                    th Id
                    th Título
                    th Ano
                    th # Géneros
                    th # Cast
                each f in list
                    tr(onclick=`window.location='/filmes/${f.id}'` style="cursor:pointer")
                        td= f.id
                        td= f.title
                        td= f.year
                        td= f.genres ? f.genres.length : 0
                        td= f.cast ? f.cast.length : 0
                        
        footer.w3-container.w3-teal
            h5 Gerado por EngWeb2026 em #{d}